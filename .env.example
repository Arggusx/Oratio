# Copie este arquivo para .env e preencha os valores.
# O .env fica só no seu computador (está no .gitignore). Na Vercel, as mesmas
# variáveis ficam em Settings > Environment Variables.
# Todas começam com VITE_ porque vão para o navegador: não coloque segredos aqui.

# URL-base da daily-prayer-api (sem /api/...).
# Produção: https://daily-prayer-api.vercel.app · hml: https://daily-prayer-api-hml.vercel.app
VITE_API_ORACAO=https://daily-prayer-api.vercel.app

# ID do cliente OAuth do Google, para "Entrar com Google". Sem ele, o botão não aparece.
VITE_GOOGLE_CLIENT_ID=

# Chave de site (pública) do Cloudflare Turnstile, usada no mural de intenções.
# Sem ela, o widget não aparece e o envio segue sem a verificação.
VITE_TURNSTILE_SITE_KEY=

# Liga a Jornada. Sem a variável (como na produção), /jornada mostra "Em breve".
# Na Vercel ela está ligada só no ambiente Preview (hml).
VITE_JORNADA=true
